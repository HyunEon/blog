{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-blog",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "blog.hyuneon.org", "custom_domain": true }],
  "assets": { "directory": ".output/public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "personal-blog", "database_id": "e57a098e-bee4-40f3-8d94-09e88a883502", "migrations_dir": "migrations" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "hyuneon.cloudflareaccess.com", "ACCESS_AUD": "633290a9b87b888801f83e694ae85183085f56ed799e2f9cc7acc7bf3eb319ce" }
}
