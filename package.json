{
  "name": "personal-blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "pnpm lint && pnpm typecheck && playwright test",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "test:worker": "pnpm build && node scripts/verify-worker.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.45.0",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.0.0",
    "nuxt": "^4.0.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@nuxt/eslint": "^1.0.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "eslint": "^10.10.0",
    "shadcn-nuxt": "^2.0.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
